# The reduction and analysis tooling is executed by bash inside WSL. With
# core.autocrlf=true on Windows, git rewrites these to CRLF on checkout and
# WSL's bash then fails on the stray \r -- silently enough that a driver script
# can appear to "run" and produce nothing (see LESSONS.md, ops).
# Pin every executable text file to LF so a fresh clone is runnable.
*.sh   text eol=lf
*.py   text eol=lf
*.sof  text eol=lf

# These execution receipts are themselves SHA-256 inputs to the E replay.
dyson-revet/out/e-release-20260912.json -text
dyson-revet/out/e-execution-20260912.json text eol=lf
dyson-revet/out/e-execution-initial-20260912.json text eol=lf

# Verbatim HTTP evidence, including archive-generated trailing whitespace.
# Keep byte hashes intact and display as raw artifacts, not editable source diffs.
DISCOVERY/XMM-C0c-2026-09-12-data/index.html -diff
DISCOVERY/XMM-C0c2-2026-09-12-data/index.html -diff
DISCOVERY/XMM-C0d-2026-09-12-data/summary.html -diff

# Immutable protocol snapshots retain their original CRLF bytes and hashes.
# Recognize CRLF line endings while keeping ordinary whitespace checks enabled.
DISCOVERY/XMM-C0d-2026-09-12-data/protocol.snapshot.md whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
DISCOVERY/XMM-C1-2026-09-12-data/protocol.snapshot.md whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# C5 binds this existing prospective definition's exact local bytes. Preserve
# its CRLF representation in Git rather than changing the pinned dependency.
DISCOVERY/XMM-CONTROL-RECOVERY-DRAFT-2026-09-12.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
DISCOVERY/XMM-MOS2-ALTERNATE-2026-09-12.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Runtime-bound prospective plans use their exact committed LF representation.
