{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gaia-dr4 day-one verdict record",
  "description": "One record per adjudicated orbit.  Produced identically by an external follow-up table (El-Badry+2026) and by the epoch-vet harness; verdict_scope says which question was answered.",
  "schema_version": "day1_verdict.v1",
  "type": "object",
  "required": [
    "source_id",
    "release",
    "orbit_source",
    "verdict",
    "verdict_scope",
    "verdict_basis",
    "verdict_confidence",
    "schema_version",
    "verdict_source",
    "verdict_source_version",
    "produced_utc",
    "run_id"
  ],
  "properties": {
    "source_id": {
      "type": "integer"
    },
    "release": {
      "type": "string"
    },
    "source_id_dr3": {
      "type": [
        "integer",
        "null"
      ]
    },
    "nss_solution_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "orbit_source": {
      "type": "string"
    },
    "orbit_period_d": {
      "type": [
        "number",
        "null"
      ]
    },
    "orbit_significance": {
      "type": [
        "number",
        "null"
      ]
    },
    "orbit_a0_mas": {
      "type": [
        "number",
        "null"
      ]
    },
    "queue_bin": {
      "type": [
        "string",
        "null"
      ]
    },
    "queue_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "n_transits_fetched": {
      "type": [
        "integer",
        "null"
      ]
    },
    "n_transits_used": {
      "type": [
        "integer",
        "null"
      ]
    },
    "f2_single_star": {
      "type": [
        "number",
        "null"
      ]
    },
    "parallax_mas": {
      "type": [
        "number",
        "null"
      ]
    },
    "excess_noise_mas": {
      "type": [
        "number",
        "null"
      ]
    },
    "fit_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "fit_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "SPURIOUS",
        "MARGINAL",
        "UNKNOWN",
        "NOT_CO",
        "OTHER",
        "INCONCLUSIVE",
        "NO_DATA",
        "ERROR"
      ]
    },
    "verdict_scope": {
      "type": "string",
      "enum": [
        "compact_companion",
        "orbit_reality"
      ]
    },
    "verdict_basis": {
      "type": "string"
    },
    "verdict_confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "verdict_confidence_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "flag_alias_1yr": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "flag_low_lat": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "flag_hi_sigma_ti2": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "flag_xray_active": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "flag_dust_unresolved_south": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "flag_dust_sigma_fragile": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "flag_astrom_quiet": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "verdict_source": {
      "type": "string"
    },
    "verdict_source_version": {
      "type": "string"
    },
    "config_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "epoch_data_release": {
      "type": [
        "string",
        "null"
      ]
    },
    "epoch_data_structure": {
      "type": [
        "string",
        "null"
      ]
    },
    "gaiasupdate_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "produced_utc": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
