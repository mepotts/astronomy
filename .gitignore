# Safety net at the portfolio root — each subproject has its own .gitignore too.

# Dependencies / environments
node_modules/
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build output
dist/
build/

# Secrets
.env
.env.*
*.token
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
esorex.log

# Frozen anonymous archive receipt contains a transient session cookie; keep local.
/DISCOVERY/XMM-C0b1-2026-09-12-data/http.json

# Frozen summary contains coordinates; C0d protocol forbids their upload.
/DISCOVERY/XMM-C0d-2026-09-12-data/summary.html
