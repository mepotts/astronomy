# Freeze and provenance hashes must survive clean checkouts without conversion.
*.md text eol=lf
# These recorded responses/results include original CRLF bytes. Preserve them.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
*.zip -text
